# Public URL of the deployed site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: enables the contact form. Without it, the Contact section shows email/phone only.
# Create a key at https://resend.com and verify a sending domain.
RESEND_API_KEY=
# Address messages are delivered to (defaults to the email in content/profile.ts).
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
